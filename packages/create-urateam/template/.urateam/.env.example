# === Required to boot ===
# `ura dev` exits with an error if any of these are missing or blank.
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=
LINEAR_TEAM_ID=

# Repository — REQUIRED. Without REPO_TEAM_ID + REPO_URL the webhook server
# starts but every inbound Linear event fails with "no repo mapping". In the
# common single-team setup, REPO_TEAM_ID is the same UUID as LINEAR_TEAM_ID.
REPO_URL=
REPO_DEFAULT_BRANCH=main
REPO_TEAM_ID=

# Database
DATABASE_URL=postgres://urateam:password@postgres:5432/urateam

# Dashboard auth (required)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# === Optional ===
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# GITHUB_WEBHOOK_SECRET=
# PM_AGENT_ENABLED=false
# PM_AGENT_TEAM_IDS=
# PM_AGENT_SLACK_CHANNEL_ID=
# PM_AGENT_DAILY_TOKEN_BUDGET=5000000
# PM_AGENT_MAX_IN_FLIGHT=3
# SLACK_BOT_TOKEN=
# LOG_LEVEL=info
# MAX_CONCURRENT_RUNS=3
# URATEAM_LICENSE_KEY=
